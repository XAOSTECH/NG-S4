#!/usr/bin/env bash
# NG-S4 master configuration.
#
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 XAOSTECH. Licensed under the GNU GPL v3 or later.
# A commercial or separate licence is available on request from the owner.
#
# Copy this file to ../real.env/master.env and edit the values below. Every
# script derives its own paths, so the project can live anywhere on any host.

# --- Path resolution (host agnostic, do not hard code absolute paths) --------
# Resolve the directory that holds THIS file, whether it is sourced or run.
_NG_S4_ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
export envDr="$_NG_S4_ENV_DIR"
scriptsDr="$(cd "$_NG_S4_ENV_DIR/../UNIX-Scripts" 2>/dev/null && pwd)"
export scriptsDr

# --- Core service configuration ---------------------------------------------
export NGINX_USER="www-data"
export NGINX_GROUP="www-data"

# Optional static web content to publish (leave empty to skip the copy step).
export NGINX_WEB_CONTENT_SRC=""
export NGINX_WEB_ROOT="/var/www/html"

# HLS output root. Playlists are served from http://<host>:<port>/hls/... .
export HLS_BASE_DIR="/mnt/hls"

# HTTP port for HLS playback, the status page and the health endpoint.
export NGINX_HTTP_PORT="8080"

# Local network allowed to publish and play over RTMP. Set this to your LAN so
# that OBS or a camera on another machine can reach the ingest.
export LAN_CIDR="192.168.0.0/24"

# Self signed certificate subject used by stunnel for the RTMPS tunnels.
export STUNNEL_SSL_SUBJECT="/C=GB/ST=England/L=London/O=NG-S4/CN=ng-s4.local"

# Directory for setup, reset and transcode logs (created by the setup script).
export LOG_DIR="/var/log/ng-s4"

# Configuration file names expected in real.env (copied into place by setup).
export NGINX_CONF_FILENAME="nginx.conf"
export STUNNEL_CONF_FILENAME="stunnel.conf"
export NGINX_PID_FILE="/run/nginx.pid"

# --- Ingest and source description ------------------------------------------
# Name of the nginx RTMP application that receives the master feed.
export INGEST_APP="ingest"

# Optional override of the transcoder input. Leave empty to pull from the local
# nginx ingest application (classic H.264/AAC path). For a 4K HDR (HEVC 10 bit)
# master, nginx RTMP cannot carry HEVC, so ingest over SRT instead, for example:
#   export INGEST_INPUT="srt://0.0.0.0:9000?mode=listener&latency=200"
# OBS can output SRT (MPEG-TS) which carries HEVC and HDR natively.
export INGEST_INPUT=""

# How to treat the source colour space: auto probes the stream, otherwise force
# hdr or sdr. SOURCE_HDR_DEFAULT is used when auto detection cannot decide.
export SOURCE_HDR="auto"
export SOURCE_HDR_DEFAULT="sdr"

# Frame rate hint used only when a target keeps the source frame rate and the
# real rate is unknown (affects the keyframe interval calculation).
export SOURCE_FPS_HINT="60"

# --- Encoder backend ---------------------------------------------------------
# auto selects NVENC on NVIDIA hosts, V4L2 M2M on Raspberry Pi, else software.
# Force one of: auto | nvenc | v4l2m2m | software
export ENCODER_BACKEND="auto"

# Optional backend tuning (safe defaults, override only if needed).
export NVENC_PRESET="p5"        # p1 (fastest) .. p7 (slowest/best)
export X264_PRESET="veryfast"
export X265_PRESET="fast"

# Audio applied to every re-encoded target (copy targets keep source audio).
export AUDIO_RATE="48000"
export AUDIO_CHANNELS="2"

# --- Restream targets --------------------------------------------------------
# The transcoder iterates over this list and reads the matching <ID>_* block.
export TARGETS="TW YT KI"

# Twitch: direct RTMP, SDR only, hard 6000 kbps ceiling. An HDR source is tone
# mapped to SDR and the frame rate is reduced to keep within Twitch limits.
export TW_ENABLE="1"
export TW_LABEL="Twitch"
export TW_TRANSPORT="rtmp"                                 # rtmp | stunnel
export TW_URL="rtmp://lhr.contribute.live-video.net/app"   # pick your nearest ingest
export TW_KEY="your_twitch_stream_key_here"
export TW_VCODEC="h264"                                    # h264 | hevc | copy
export TW_HDR="sdr"                                        # sdr forces tone mapping of HDR
export TW_SCALE="1920:-2"                                  # WxH, -2 keeps aspect; empty keeps source
export TW_FPS="30"                                         # downmix frame rate; empty keeps source
export TW_VBITRATE="6000k"
export TW_MAXRATE="6000k"
export TW_BUFSIZE="9000k"
export TW_ABITRATE="160k"
export TW_GOP_SECONDS="2"

# YouTube: RTMPS through stunnel, HDR preserved. Use hevc for HDR (H.264 cannot
# carry 10 bit HDR). Set YT_VCODEC="copy" to pass an already HEVC HDR master
# straight through without re-encoding (lowest latency and CPU/GPU cost).
export YT_ENABLE="1"
export YT_LABEL="YouTube"
export YT_TRANSPORT="stunnel"                              # local stunnel entrance below
export YT_STUNNEL_PORT="19351"
export YT_URL="rtmp://127.0.0.1:19351/live2"
export YT_KEY="your_youtube_stream_key_here"
export YT_VCODEC="hevc"                                    # hevc | copy | h264
export YT_HDR="hdr"                                        # keep the HDR colour space
export YT_SCALE=""                                         # keep source (e.g. 3840x2160)
export YT_FPS=""                                           # keep source (e.g. 60)
export YT_VBITRATE="45000k"
export YT_MAXRATE="51000k"
export YT_BUFSIZE="90000k"
export YT_ABITRATE="192k"
export YT_GOP_SECONDS="2"

# Kick: RTMPS through stunnel, SDR H.264 by default. Disabled until configured.
export KI_ENABLE="0"
export KI_LABEL="Kick"
export KI_TRANSPORT="stunnel"
export KI_STUNNEL_PORT="19352"
export KI_URL="rtmp://127.0.0.1:19352/app"
export KI_KEY="your_kick_stream_key_here"
export KI_VCODEC="h264"
export KI_HDR="sdr"
export KI_SCALE="1920:-2"
export KI_FPS="60"
export KI_VBITRATE="6000k"
export KI_MAXRATE="6000k"
export KI_BUFSIZE="9000k"
export KI_ABITRATE="160k"
export KI_GOP_SECONDS="2"
