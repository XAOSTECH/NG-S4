#!/usr/bin/env bash
# NG-S4 local test profile: transcode to a local HLS sink. No keys, no network.
#
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 XAOSTECH. Licensed under the GNU GPL v3 or later.
# A commercial or separate licence is available on request from the owner.
#
# Every value honours an existing environment override (VAR="${VAR:-default}"),
# so a test runner can redirect the input and output without editing this file.

export TARGETS="LO"

# Local HLS sink: writes index.m3u8 and .ts segments into a directory on disk.
export LO_ENABLE="${LO_ENABLE:-1}"
export LO_LABEL="${LO_LABEL:-LocalHLS}"
export LO_INGEST="local"
export LO_URL="${LO_URL:-/tmp/ng-s4-test/hls}"
export LO_KEY="${LO_KEY:-local}"
export LO_VCODEC="${LO_VCODEC:-h264}"
export LO_HDR="${LO_HDR:-sdr}"
export LO_SCALE="${LO_SCALE:-1280:-2}"
export LO_FPS="${LO_FPS:-30}"
export LO_VBITRATE="${LO_VBITRATE:-3000k}"
export LO_MAXRATE="${LO_MAXRATE:-3000k}"
export LO_BUFSIZE="${LO_BUFSIZE:-6000k}"
export LO_ABITRATE="${LO_ABITRATE:-128k}"
export LO_GOP_SECONDS="${LO_GOP_SECONDS:-2}"
export LO_HLS_TIME="${LO_HLS_TIME:-2}"
export LO_HLS_SEGS="${LO_HLS_SEGS:-6}"
